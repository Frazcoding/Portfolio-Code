      "source": [
        "# 🔧 Climate Data Processor\n",
        "\n",
        "**Notebook 2 of 3: Processing and Enriching Raw Climate Data**\n",
        "\n",
        "## 📋 Purpose\n",
        "This notebook processes the raw hourly climate data fetched in Notebook 1:\n",
        "- Cleans missing values and outliers\n",
        "- Calculates derived metrics (solar radiation, HDD, CDD)\n",
        "- Aggregates to monthly statistics\n",
        "- Saves processed data for use in the heat pump simulation\n",
        "\n",
        "## 📊 Input Data\n",
        "- Raw hourly CSV files from `data/climate/`\n",
        "- 11 UK cities, 10 years of hourly data\n",
        "\n",
        "## 📤 Output Data\n",
        "- Processed CSV files with derived metrics\n",
        "- Monthly statistics CSV files\n",
        "- Metadata summary\n",
        "\n",
        "## 🔗 Dependencies\n",
        "- pandas\n",
        "- numpy\n",
        "- tqdm"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Import libraries\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import os\n",
        "from datetime import datetime\n",
        "from tqdm import tqdm\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 📍 Setup Directories and Load Metadata"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Define directories\n",
        "RAW_DATA_DIR = '../data/climate'\n",
        "PROCESSED_DATA_DIR = '../data/climate/processed'\n",
        "MONTHLY_DATA_DIR = '../data/climate/monthly'\n",
        "\n",
        "# Create output directories\n",
        "os.makedirs(PROCESSED_DATA_DIR, exist_ok=True)\n",
        "os.makedirs(MONTHLY_DATA_DIR, exist_ok=True)\n",
        "\n",
        "# Load city metadata\n",
        "metadata_path = '../data/climate/uk_cities_metadata.csv'\n",
        "cities_df = pd.read_csv(metadata_path)\n",
        "cities = cities_df.to_dict('records')\n",
        "\n",
        "print(f'📁 Raw data directory: {RAW_DATA_DIR}')\n",
        "print(f'📁 Processed data directory: {PROCESSED_DATA_DIR}')\n",
        "print(f'📁 Monthly data directory: {MONTHLY_DATA_DIR}')\n",
        "print(f'🌍 Cities to process: {len(cities)}')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# List all raw CSV files\n",
        "raw_files = [f for f in os.listdir(RAW_DATA_DIR) if f.endswith('_2014-2024_hourly.csv')]\n",
        "raw_files.sort()\n",
        "\n",
        "print(f'📄 Found {len(raw_files)} raw data files:')\n",
        "for i, f in enumerate(raw_files, 1):\n",
        "    print(f'{i}. {f}')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 🏗️ Climate Data Processor Class\n",
        "A reusable class for processing raw climate data."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "class ClimateDataProcessor:\n",
        "    \"\"\"\n",
        "    Processes raw hourly climate data into heat pump-ready format.\n",
        "    \n",
        "    Calculates:\n",
        "    - Solar radiation from sunshine duration\n",
        "    - Heating Degree Days (HDD)\n",
        "    - Cooling Degree Days (CDD)\n",
        "    - Design temperatures (1% and 99% percentiles)\n",
        "    - Monthly aggregated statistics\n",
        "    \"\"\"\n",
        "    \n",
        "    def __init__(self, raw_data_dir: str = '../data/climate',\n",
        "                 processed_data_dir: str = '../data/climate/processed',\n",
        "                 monthly_data_dir: str = '../data/climate/monthly'):\n",
        "        self.raw_data_dir = raw_data_dir\n",
        "        self.processed_data_dir = processed_data_dir\n",
        "        self.monthly_data_dir = monthly_data_dir\n",
        "        \n",
        "        os.makedirs(processed_data_dir, exist_ok=True)\n",
        "        os.makedirs(monthly_data_dir, exist_ok=True)\n",
        "    \n",
        "    def load_raw_data(self, city_name: str) -> pd.DataFrame:\n",
        "        \"\"\"\n",
        "        Load raw hourly data for a city.\n",
        "        \"\"\"\n",
        "        filename = f'{city_name.lower().replace(" ", "_")}_2014-2024_hourly.csv'\n",
        "        filepath = os.path.join(self.raw_data_dir, filename)\n",
        "        \n",
        "        if not os.path.exists(filepath):\n",
        "            print(f'⚠️  File not found: {filepath}')\n",
        "            return pd.DataFrame()\n",
        "        \n",
        "        df = pd.read_csv(filepath, parse_dates=['time'], index_col='time')\n",
        "        return df\n",
        "    \n",
        "    def clean_data(self, df: pd.DataFrame, city_name: str) -> pd.DataFrame:\n",
        "        \"\"\"\n",
        "        Clean raw climate data:\n",
        "        - Handle missing values\n",
        "        - Remove outliers\n",
        "        - Add derived columns\n",
        "        \"\"\"\n",
        "        if df.empty:\n",
        "            return df\n",
        "        \n",
        "        # Create a copy to avoid modifying the original\n",
        "        cleaned = df.copy()\n",
        "        \n",
        "        # Add city name if not present\n",
        "        if 'city' not in cleaned.columns:\n",
        "            cleaned['city'] = city_name\n",
        "        \n",
        "        # Add datetime components for easier analysis\n",
        "        cleaned['year'] = cleaned.index.year\n",
        "        cleaned['month'] = cleaned.index.month\n",
        "        cleaned['day'] = cleaned.index.day\n",
        "        cleaned['hour'] = cleaned.index.hour\n",
        "        cleaned['day_of_year'] = cleaned.index.dayofyear\n",
        "        \n",
        "        # Handle missing values\n",
        "        # For temperature, humidity, wind: interpolate missing values\n",
        "        temp_cols = ['temp', 'dwpt', 'rhum', 'wspd', 'pres']\n",
        "        for col in temp_cols:\n",
        "            if col in cleaned.columns:\n",
        "                # Forward fill, then backward fill, then interpolate\n",
        "                cleaned[col] = cleaned[col].ffill().bfill()\n",
        "                cleaned[col] = cleaned[col].interpolate(method='time', limit=24)\n",
        "        \n",
        "        # For precipitation and sunshine: fill with 0 (no rain/sunshine)\n",
        "        precip_cols = ['precip', 'tsun']\n",
        "        for col in precip_cols:\n",
        "            if col in cleaned.columns:\n",
        "                cleaned[col] = cleaned[col].fillna(0)\n",
        "        \n",
        "        # Remove outliers using IQR method (for temperature and wind speed)\n",
        "        for col in ['temp', 'wspd']:\n",
        "            if col in cleaned.columns:\n",
        "                Q1 = cleaned[col].quantile(0.01)\n",
        "                Q3 = cleaned[col].quantile(0.99)\n",
        "                IQR = Q3 - Q1\n",
        "                lower_bound = Q1 - 1.5 * IQR\n",
        "                upper_bound = Q3 + 1.5 * IQR\n",
        "                cleaned = cleaned[(cleaned[col] >= lower_bound) & (cleaned[col] <= upper_bound)]\n",
        "        \n",
        "        return cleaned\n",
        "    \n",
        "    def calculate_solar_radiation(self, df: pd.DataFrame) -> pd.DataFrame:\n",
        "        \"\"\"\n",
        "        Calculate solar radiation from sunshine duration.\n",
        "        \n",
        "        Uses the Angstrom-Prescott correlation:\n",
        "        G = (a + b * (n/N)) * Ra\n",
        "        Where:\n",
        "        - G: Global solar radiation (W/m²)\n",
        "        - n: Sunshine duration (hours)\n",
        "        - N: Maximum possible sunshine duration (hours)\n",
        "        - Ra: Extraterrestrial radiation (W/m²)\n",
        "        - a, b: Empirical coefficients (0.25 and 0.5 for UK)\n",
        "        \"\"\"\n",
        "        if 'tsun' not in df.columns:\n",
        "            return df\n",
        "        \n",
        "        result = df.copy()\n",
        "        \n",
        "        # Convert sunshine from minutes to hours\n",
        "        result['sunshine_hours'] = result['tsun'] / 60\n",
        "        \n",
        "        # Calculate day of year and solar geometry\n",
        "        day_of_year = result.index.dayofyear\n",
        "        latitude = df['lat'].iloc[0] if 'lat' in df.columns else 55.0  # Default to UK latitude\n",
        "        \n",
        "        # Calculate extraterrestrial radiation (Ra) in W/m²\n",
        "        # Simplified calculation for UK latitude\n",
        "        solar_declination = 23.45 * np.sin(np.radians(360 * (284 + day_of_year) / 365))\n",
        "        hour_angle = 15 * (12 - result.index.hour)  # Solar noon at 12:00\n",
        "        \n",
        "        # Calculate Ra using simplified formula (approx. 1367 W/m² at top of atmosphere)\n",
        "        Ra = 1367 * (1 + 0.033 * np.cos(np.radians(360 * day_of_year / 365))) * \\\n",
        "             np.sin(np.radians(90 - latitude + solar_declination)) * \\\n",
        "             np.cos(np.radians(hour_angle))\n",
        "        \n",
        "        # Ensure Ra is non-negative\n",
        "        Ra = np.maximum(Ra, 0)\n",
        "        \n",
        "        # Calculate maximum possible sunshine duration (N) in hours\n",
        "        N = (24 / np.pi) * np.arccos(-np.tan(np.radians(latitude)) * np.tan(np.radians(solar_declination)))\n",
        "        N = np.maximum(N, 0)\n",
        "        \n",
        "        # Angstrom-Prescott correlation with UK coefficients\n",
        "        a = 0.25\n",
        "        b = 0.5\n",
        "        n_N_ratio = result['sunshine_hours'] / N\n",
        "        n_N_ratio = np.clip(n_N_ratio, 0, 1)  # Clamp between 0 and 1\n",
        "        \n",
        "        # Calculate global solar radiation in W/m²\n",
        "        result['solar_rad'] = (a + b * n_N_ratio) * Ra\n",
        "        \n",
        "        # For nighttime hours, set solar radiation to 0\n",
        "        sunrise_hour = 6  # Approximate for UK\n",
        "        sunset_hour = 18  # Approximate for UK\n",
        "        result.loc[(result.index.hour < sunrise_hour) | (result.index.hour >= sunset_hour), 'solar_rad'] = 0\n",
        "        \n",
        "        return result\n",
        "    \n",
        "    def calculate_hdd_cdd(self, df: pd.DataFrame, \n",
        "                         hdd_base: float = 15.5, \n",
        "                         cdd_base: float = 22.0) -> pd.DataFrame:\n",
        "        \"\"\"\n",
        "        Calculate Heating Degree Days (HDD) and Cooling Degree Days (CDD).\n",
        "        \n",
        "        Parameters\n",
        "        ----------\n",
        "        df : pd.DataFrame\n",
        "            hourly climate data\n",
        "        hdd_base : float, optional\n",
        "            Base temperature for HDD calculation (default 15.5°C for UK)\n",
        "        cdd_base : float, optional\n",
        "            Base temperature for CDD calculation (default 22.0°C)\n",
        "        \n",
        "        Returns\n",
        "        -------\n",
        "        pd.DataFrame\n",
        "            DataFrame with added HDD and CDD columns (daily totals)\n",
        "        \"\"\"\n",
        "        if 'temp' not in df.columns:\n",
        "            return df\n",
        "        \n",
        "        result = df.copy()\n",
        "        \n",
        "        # Calculate daily average temperature\n",
        "        daily_avg = result['temp'].resample('D').mean()\n",
        "        \n",
        "        # Calculate daily HDD and CDD\n",
        "        daily_hdd = np.maximum(0, hdd_base - daily_avg)\n",
        "        daily_cdd = np.maximum(0, daily_avg - cdd_base)\n",
        "        \n",
        "        # Map daily values back to hourly DataFrame\n",
        "        result['hdd_daily'] = result.index.map(lambda x: daily_hdd.get(x.date(), 0))\n",
        "        result['cdd_daily'] = result.index.map(lambda x: daily_cdd.get(x.date(), 0))\n",
        "        \n",
        "        # Calculate cumulative annual HDD and CDD\n",
        "        result['hdd_annual'] = result.groupby(result.index.year)['hdd_daily'].transform('sum')\n",
        "        result['cdd_annual'] = result.groupby(result.index.year)['cdd_daily'].transform('sum')\n",
        "        \n",
        "        return result\n",
        "    \n",
        "    def calculate_design_temperatures(self, df: pd.DataFrame) -> dict:\n",
        "        \"\"\"\n",
        "        Calculate design temperatures (1% and 99% percentiles).\n",
        "        \n",
        "        Returns\n",
        "        -------\n",
        "        dict\n",
        "            Dictionary with design temperatures:\n",
        "            - winter_design_temp: 1% percentile (coldest temperature)\n",
        "            - summer_design_temp: 99% percentile (hottest temperature)\n",
        "            - avg_temp: Long-term average temperature\n",
        "        \"\"\"\n",
        "        if 'temp' not in df.columns:\n",
        "            return {}\n",
        "        \n",
        "        # Calculate percentiles\n",
        "        winter_design = df['temp'].quantile(0.01)  # 1% percentile (cold)\n",
        "        summer_design = df['temp'].quantile(0.99)  # 99% percentile (hot)\n",
        "        avg_temp = df['temp'].mean()\n",
        "        \n",
        "        return {\n",
        "            'winter_design_temp': float(winter_design),\n",
        "            'summer_design_temp': float(summer_design),\n",
        "            'avg_temp': float(avg_temp),\n",
        "            'min_temp': float(df['temp'].min()),\n",
        "            'max_temp': float(df['temp'].max())\n",
        "        }\n",
        "    \n",
        "    def aggregate_monthly_stats(self, df: pd.DataFrame) -> pd.DataFrame:\n",
        "        \"\"\"\n",
        "        Aggregate hourly data to monthly statistics.\n",
        "        \n",
        "        Returns\n",
        "        -------\n",
        "        pd.DataFrame\n",
        "            Monthly aggregated statistics with the following columns:\n",
        "            - year, month\n",
        "            - avg_temp, min_temp, max_temp\n",
        "            - avg_humidity\n",
        "            - avg_wind_speed\n",
        "            - avg_solar_rad\n",
        "            - total_precip\n",
        "            - hdd_monthly\n",
        "            - cdd_monthly\n",
        "        \"\"\"\n",
        "        if df.empty:\n",
        "            return pd.DataFrame()\n",
        "        \n",
        "        # Group by year and month\n",
        "        monthly = df.groupby([df.index.year, df.index.month]).agg({\n",
        "            'temp': ['mean', 'min', 'max'],\n",
        "            'rhum': 'mean',\n",
        "            'wspd': 'mean',\n",
        "            'solar_rad': 'mean',\n",
        "            'precip': 'sum',\n",
        "            'hdd_daily': 'sum',\n",
        "            'cdd_daily': 'sum'\n",
        "        })\n",
        "        \n",
        "        # Flatten multi-index columns\n",
        "        monthly.columns = [\n",
        "            'avg_temp', 'min_temp', 'max_temp',\n",
        "            'avg_humidity', 'avg_wind_speed',\n",
        "            'avg_solar_rad', 'total_precip',\n",
        "            'hdd_monthly', 'cdd_monthly'\n",
        "        ]\n",
        "        monthly = monthly.reset_index()\n",
        "        monthly.columns = ['year', 'month'] + list(monthly.columns[2:])\n",
        "        \n",
        "        return monthly\n",
        "    \n",
        "    def process_city(self, city_name: str) -> dict:\n",
        "        \"\"\"\n",
        "        Full processing pipeline for one city.\n",
        "        \n",
        "        Returns\n",
        "        -------\n",
        "        dict\n",
        "            Dictionary with processed data and statistics\n",
        "        \"\"\"\n",
        "        # Load raw data\n",
        "        df = self.load_raw_data(city_name)\n",
        "        \n",
        "        if df.empty:\n",
        "            print(f'⚠️  No data found for {city_name}')\n",
        "            return None\n",
        "        \n",
        "        print(f'🔧 Processing {city_name}...')\n",
        "        \n",
        "        # Clean data\n",
        "        cleaned = self.clean_data(df, city_name)\n",
        "        \n",
        "        # Calculate solar radiation\n",
        "        with_solar = self.calculate_solar_radiation(cleaned)\n",
        "        \n",
        "        # Calculate HDD and CDD\n",
        "        with_hdd_cdd = self.calculate_hdd_cdd(with_solar)\n",
        "        \n",
        "        # Calculate design temperatures\n",
        "        design_temps = self.calculate_design_temperatures(with_hdd_cdd)\n",
        "        \n",
        "        # Aggregate monthly statistics\n",
        "        monthly_stats = self.aggregate_monthly_stats(with_hdd_cdd)\n",
        "        \n",
        "        # Save processed data\n",
        "        processed_filename = f'{city_name.lower().replace(" ", "_")}_2014-2024_hourly_processed.csv'\n",
        "        processed_path = os.path.join(self.processed_data_dir, processed_filename)\n",
        "        with_hdd_cdd.to_csv(processed_path)\n",
        "        \n",
        "        # Save monthly statistics\n",
        "        monthly_filename = f'{city_name.lower().replace(" ", "_")}_monthly_stats.csv'\n",
        "        monthly_path = os.path.join(self.monthly_data_dir, monthly_filename)\n",
        "        monthly_stats.to_csv(monthly_path, index=False)\n",
        "        \n",
        "        print(f'   ✅ Saved processed data to {processed_path}')\n",
        "        print(f'   ✅ Saved monthly stats to {monthly_path}')\n",
        "        \n",
        "        return {\n",
        "            'city': city_name,\n",
        "            'processed_data': with_hdd_cdd,\n",
        "            'monthly_stats': monthly_stats,\n",
        "            'design_temps': design_temps,\n",
        "            'processed_path': processed_path,\n",
        "            'monthly_path': monthly_path\n",
        "        }\n",
        "    \n",
        "    def process_all_cities(self, cities: list) -> dict:\n",
        "        \"\"\"\n",
        "        Process all cities in the list.\n",
        "        \n",
        "        Returns\n",
        "        -------\n",
        "        dict\n",
        "            Dictionary with results for all cities\n",
        "        \"\"\"\n",
        "        results = {}\n",
        "        \n",
        "        for city in tqdm(cities, desc='Processing cities'):\n",
        "            city_name = city['city_name']\n",
        "            result = self.process_city(city_name)\n",
        "            if result:\n",
        "                results[city_name] = result\n",
        "        \n",
        "        return results"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 🚀 Process All Cities\n",
        "Run the full processing pipeline for all 11 UK cities."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Initialize the processor\n",
        "processor = ClimateDataProcessor()\n",
        "\n",
        "# Process all cities\n",
        "print('🔧 Starting climate data processing...')\n",
        "print('=' * 60)\n",
        "\n",
        "results = processor.process_all_cities(cities)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 📊 Processing Summary"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Display summary of processed data\n",
        "print('=' * 60)\n",
        "print(f'✅ Successfully processed {len(results)}/{len(cities)} cities')\n",
        "print('=' * 60)\n",
        "\n",
        "# Show design temperatures for each city\n",
        "print('🌡️  Design Temperatures (1% winter / 99% summer):')\n",
        "print('-' * 80)\n",
        "\n",
        "design_temps_data = []\n",
        "for city_name, result in results.items():\n",
        "    design = result['design_temps']\n",
        "    design_temps_data.append({\n",
        "        'City': city_name,\n",
        "        'Avg Temp (°C)': design['avg_temp'],\n",
        "        'Min Temp (°C)': design['min_temp'],\n",
        "        'Max Temp (°C)': design['max_temp'],\n",
        "        'Winter Design (°C)': design['winter_design_temp'],\n",
        "        'Summer Design (°C)': design['summer_design_temp']\n",
        "    })\n",
        "\n",
        "design_df = pd.DataFrame(design_temps_data)\n",
        "display(design_df)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Show HDD and CDD summary\n",
        "print('\\n🔥 Heating and Cooling Degree Days Summary:')\n",
        "print('-' * 80)\n",
        "\n",
        "hdd_cdd_data = []\n",
        "for city_name, result in results.items():\n",
        "    df = result['processed_data']\n",
",
        "    # Get average annual HDD and CDD\n",
        "    avg_hdd = df.groupby(df.index.year)['hdd_annual'].mean().mean()\n",
        "    avg_cdd = df.groupby(df.index.year)['cdd_annual'].mean().mean()\n",
        "    \n",
        "    hdd_cdd_data.append({\n",
        "        'City': city_name,\n",
        "        'Avg Annual HDD (°C·days)': avg_hdd,\n",
        "        'Avg Annual CDD (°C·days)': avg_cdd\n",
        "    })\n",
        "\n",
        "hdd_cdd_df = pd.DataFrame(hdd_cdd_data)\n",
        "display(hdd_cdd_df)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Show data completeness\n",
        "print('\\n📈 Data Completeness:')\n",
        "print('-' * 80)\n",
        "\n",
        "completeness_data = []\n",
        "for city_name, result in results.items():\n",
        "    df = result['processed_data']\n",
",
        "    total_hours = len(df)\n",
        "    expected_hours = 10 * 365.25 * 24  # 10 years\n",
",
        "    completeness_pct = (total_hours / expected_hours) * 100\n",
        "    \n",
        "    completeness_data.append({\n",
        "        'City': city_name,\n",
        "        'Total Hours': total_hours,\n",
        "        'Expected Hours': expected_hours,\n",
        "        'Completeness (%)': completeness_pct\n",
        "    })\n",
        "\n",
        "completeness_df = pd.DataFrame(completeness_data)\n",
        "display(completeness_df)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
